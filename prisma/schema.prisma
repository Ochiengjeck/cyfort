generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id              String  @id @default(cuid())
  siteName        String  @default("CyFort Technologies Limited")
  shortName       String  @default("CYFORT")
  tagline         String  @default("Securing Digital Growth Across Africa")
  categoryLine    String  @default("TECHNOLOGY · ADVISORY · CYBERSECURITY")
  metaDescription String?
  logoMediaId     String?
  faviconMediaId  String?
  contactEmail    String  @default("info@cyfort.africa")
  contactPhone    String  @default("+254 7__ ___ ___")
  contactAddress  String?
  linkedinUrl     String?
  twitterUrl      String?
  facebookUrl     String?
  footerText      String?

  colorDark      String @default("#0A0A0B")
  colorInk       String @default("#141414")
  colorGold      String @default("#C9A227")
  colorGoldDark  String @default("#9C7A3C")
  colorGoldLight String @default("#E8CE8F")
  colorPaper     String @default("#F7F6F2")
  colorPaperAlt  String @default("#EFEDE6")
  colorMuted     String @default("#9CA3AF")

  updatedAt DateTime @updatedAt
}

model NavLink {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  label        String
  href         String
  openInNewTab Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomeHero {
  id                String   @id @default(cuid())
  eyebrow           String   @default("TECHNOLOGY · ADVISORY · CYBERSECURITY")
  headlineLead      String   @default("Securing")
  headlineEmphasis  String   @default("Digital Growth Across Africa")
  primaryCtaLabel   String   @default("Explore Our Services")
  primaryCtaHref    String   @default("/services")
  secondaryCtaLabel String   @default("Talk to Us")
  secondaryCtaHref  String   @default("/contact")
  updatedAt         DateTime @updatedAt
}

model AboutContent {
  id                   String   @id @default(cuid())
  whoWeAreBody         String
  pullQuote            String   @default("At CYFORT, we believe cybersecurity is no longer just an IT function — it is a business imperative.")
  vision               String
  mission              String
  approachIntro        String
  approachBody         String
  comparisonLeftLabel  String   @default("Most Firms")
  comparisonLeftText   String   @default("Begin with technology")
  comparisonRightLabel String   @default("We")
  comparisonRightText  String   @default("Begin With The Business")
  closingEyebrow       String   @default("LOOKING AHEAD")
  closingHeading       String   @default("Securing Tomorrow's Digital Africa")
  closingBody          String
  closingQuote         String   @default("Together, we help organizations secure today, prepare for tomorrow, and build confidence in a digital future.")

  closingPrimaryCtaLabel   String  @default("Book a Health Check")
  closingPrimaryCtaHref    String  @default("/contact")
  closingSecondaryCtaLabel String  @default("Talk to a partner")
  closingSecondaryCtaHref  String  @default("/contact")
  trustStripLabel          String? @default("BUILT FOR ORGANISATIONS ANSWERING TO")
  trustBadges              String? @default("ODPC · Data Protection Act 2019\nSASRA\nCentral Bank of Kenya\nDonor & UN due diligence\nISO/IEC 27001")

  updatedAt DateTime @updatedAt
}

model Differentiator {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServicePillar {
  ADVISE
  SECURE_ASSURE
  BUILD_RUN
}

model Service {
  id        String        @id @default(cuid())
  order     Int           @default(0)
  slug      String        @unique
  name      String
  summary   String
  icon      String?
  approach  String?
  outcomes  String?
  items     ServiceItem[]

  pillar       ServicePillar @default(SECURE_ASSURE)
  featured     Boolean       @default(false)
  ctaLabel     String?
  ctaHref      String?
  builtForTags String?
  triggerText  String?

  industries Industry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceItem {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  label     String
  createdAt DateTime @default(now())
}

model Industry {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  name         String
  blurb        String?
  icon         String?
  imageMediaId String?

  featured       Boolean  @default(false)
  drivingText    String?
  startText      String?
  startServiceId String?
  startService   Service? @relation(fields: [startServiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromiseItem {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id           String       @id @default(cuid())
  order        Int          @default(0)
  name         String
  role         String
  bio          String?
  photoMediaId String?
  linkedinUrl  String?
  email        String?
  reportsToId  String?
  reportsTo    TeamMember?  @relation("TeamHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports      TeamMember[] @relation("TeamHierarchy")
  published    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CaseStudy {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  clientName        String
  industryTag       String?
  summary           String
  body              String
  coverMediaId      String?
  resultsSummary    String?
  testimonialQuote  String?
  testimonialAuthor String?
  duration          String?
  teamSize          String?
  published         Boolean   @default(false)
  publishedAt       DateTime?
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model InsightPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  body         String
  coverMediaId String?
  authorName   String?
  authorRole   String?
  category     String?
  tags         String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model JobPosting {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  department       String?
  location         String?
  employmentType   String?
  summary          String
  description      String
  coverMediaId     String?
  responsibilities String?
  requirements     String?
  benefits         String?
  salaryRange      String?
  applyEmail       String?
  published        Boolean   @default(false)
  closesAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  ipAddress String?
  userAgent String?

  serviceInterest String?
  sector          String?
  consent         Boolean @default(false)

  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  alt       String?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
